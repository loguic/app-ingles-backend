      "units": [
        {
          "id": "a1-u1",
          "title": "Basics: Greetings & Introductions",
          "lessons": [
            {
              "id": "a1-u1-l1",
              "title": "Introduce yourself directly",
              "objective": "Build, expand and transfer a personal introduction directly in English.",
              "experience": {
                "contract_version": "2.0",
                "pedagogical_method": "direct_english_construction",
                "mission": {
                  "id": "a1-u1-l1-m1",
                  "title": "Meet someone and introduce yourself",
                  "situation": "Meet a new person and share only the simple personal information you choose, which may be fictional.",
                  "observable_outcome": "Build an introduction from a person and a verb, add one relevant detail and answer one related variation in your own words.",
                  "success_criteria": [
                    "The learner constructs a guided personal response without copying a complete answer.",
                    "The learner adds new information about origin, routine, activity or interest.",
                    "The learner answers a related transfer prompt without language support.",
                    "Voice is the primary evidence modality and any text response remains a fallback."
                  ]
                },
                "skill_ids": [
                  "a1_introduce_yourself"
                ],
                "stages": [
                  {
                    "id": "a1-u1-l1-s1",
                    "type": "encounter",
                    "instruction": "Notice Persona, Verbo and detail in the model, listen for rhythm and shadow the short phrase.",
                    "activity_ids": [
                      "a1-u1-l1-c1",
                      "a1-u1-l1-c2"
                    ],
                    "mode": "required",
                    "completion_condition": "all_activities_completed"
                  },
                  {
                    "id": "a1-u1-l1-s2",
                    "type": "guided_production",
                    "instruction": "Build a personal response using only the Persona and Verbo anchors.",
                    "activity_ids": [
                      "a1-u1-l1-c-direct-guided"
                    ],
                    "mode": "required",
                    "completion_condition": "evidence_recorded"
                  },
                  {
                    "id": "a1-u1-l1-s3",
                    "type": "applied_conversation",
                    "instruction": "Expand the construction with one relevant detail using only the initial word.",
                    "activity_ids": [
                      "a1-u1-l1-c-direct-expanded"
                    ],
                    "mode": "required",
                    "completion_condition": "evidence_recorded"
                  },
                  {
                    "id": "a1-u1-l1-s4",
                    "type": "evidence",
                    "instruction": "Answer one related unexpected question in your own words without language support.",
                    "activity_ids": [
                      "a1-u1-l1-c-direct-transfer"
                    ],
                    "mode": "required",
                    "completion_condition": "evidence_recorded"
                  },
                  {
                    "id": "a1-u1-l1-s5",
                    "type": "closure",
                    "instruction": "Confirm that guided, expanded and transfer productions were recorded; completion does not mean progress or mastery.",
